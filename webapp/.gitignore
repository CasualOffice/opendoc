# wasm/site build output — rebuilt locally and in CI; chrome fonts stay tracked.
/pkg/
/assets/*
!/assets/fonts/
!/assets/fonts/*
/demo.docx
# Generated by `build.sh` from the importer's own fixture builder, for the same
# reason `demo.docx` is copied rather than tracked: a committed binary drifts
# from the generator that claims to produce it.
/demo.pptx
/sample.docx

# Playwright run artifacts (test-results/, HTML report) — regenerated per run.
/playwright-report/
/test-results/

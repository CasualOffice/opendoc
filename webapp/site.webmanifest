{
  "name": "OpenDoc",
  "short_name": "OpenDoc",
  "description": "An Apache-2.0, embeddable, local-first editor for Word documents, running in the browser on a Rust and WebAssembly engine.",
  "lang": "en",
  "dir": "ltr",
  "id": "./editor.html",
  "start_url": "./editor.html",
  "scope": "./",
  "display": "browser",
  "background_color": "#fbfaf8",
  "theme_color": "#fbfaf8",
  "icons": [
    { "src": "./opendoc-mark.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./apple-touch-icon.png", "sizes": "180x180", "type": "image/png", "purpose": "any" }
  ]
}

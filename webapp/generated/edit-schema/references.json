{
  "description": "One edit of the `references` family of the OpenDoc edit vocabulary 1.4.",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "Insert a table of contents before a body paragraph: one entry per\nheading, with the page it is on, as one field an update finds again.",
      "properties": {
        "before": {
          "additionalProperties": false,
          "description": "The body paragraph the table goes before (its id; a quote is not\nneeded).",
          "properties": {
            "exact": {
              "description": "The quoted text, matched inside `node` only.",
              "type": [
                "string",
                "null"
              ]
            },
            "node": {
              "description": "A paragraph id returned by `get_outline`, `read_blocks` or `search`.",
              "type": "string"
            },
            "occurrence": {
              "description": "1-based occurrence of `exact` among the matches that remain.",
              "format": "uint32",
              "minimum": 1,
              "type": [
                "integer",
                "null"
              ]
            },
            "pos": {
              "additionalProperties": false,
              "description": "Offsets for programs only; never computed by a model.",
              "properties": {
                "end": {
                  "description": "End, exclusive.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "start": {
                  "description": "Start, UTF-8 bytes into the node's text.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "start",
                "end"
              ],
              "type": [
                "object",
                "null"
              ]
            },
            "prefix": {
              "description": "Text immediately before `exact`, to disambiguate.",
              "type": [
                "string",
                "null"
              ]
            },
            "side": {
              "anyOf": [
                {
                  "description": "Which side of the target an insertion goes.",
                  "oneOf": [
                    {
                      "const": "before",
                      "description": "Before the quote (or at the paragraph's start).",
                      "type": "string"
                    },
                    {
                      "const": "after",
                      "description": "After the quote (or at the paragraph's end). The default.",
                      "type": "string"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "For an insertion point: before or after the target."
            },
            "suffix": {
              "description": "Text immediately after `exact`, to disambiguate.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "node"
          ],
          "type": "object"
        },
        "levels": {
          "description": "The deepest heading level listed, 1 to 9; 3 when omitted.",
          "format": "uint8",
          "maximum": 9,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "op": {
          "const": "insert_table_of_contents",
          "type": "string"
        }
      },
      "required": [
        "op",
        "before"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Update a table of contents.",
      "properties": {
        "field": {
          "description": "The table's field id, as `read_blocks` lists it; omitted, the\ndocument's only table of contents.",
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "description": "`page_numbers` keeps the entries and re-reads their pages;\n`entire` rebuilds the entries from the headings.",
          "oneOf": [
            {
              "const": "page_numbers",
              "description": "Keep the entries; re-read every entry's page number.",
              "type": "string"
            },
            {
              "const": "entire",
              "description": "Rebuild the entries from the current headings.",
              "type": "string"
            }
          ]
        },
        "op": {
          "const": "update_table_of_contents",
          "type": "string"
        }
      },
      "required": [
        "op",
        "mode"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Insert a numbered caption above or below a table, picture or\nparagraph in the body; later captions of the same label renumber.",
      "properties": {
        "chapter_level": {
          "description": "Include the chapter number, counted from headings of this level\n(1 to 9).",
          "format": "uint8",
          "maximum": 9,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "exclude_label": {
          "default": false,
          "description": "Leave the label out and show only the number.",
          "type": "boolean"
        },
        "label": {
          "description": "The label and numbering sequence: `Figure`, `Table`, `Equation` or\nany label the document already uses.",
          "type": "string"
        },
        "number_format": {
          "default": "arabic",
          "description": "How the number is written; arabic when omitted.",
          "oneOf": [
            {
              "const": "arabic",
              "description": "1, 2, 3 (the default).",
              "type": "string"
            },
            {
              "const": "upper_roman",
              "description": "I, II, III.",
              "type": "string"
            },
            {
              "const": "lower_roman",
              "description": "i, ii, iii.",
              "type": "string"
            },
            {
              "const": "upper_letter",
              "description": "A, B, C.",
              "type": "string"
            },
            {
              "const": "lower_letter",
              "description": "a, b, c.",
              "type": "string"
            }
          ]
        },
        "op": {
          "const": "insert_caption",
          "type": "string"
        },
        "position": {
          "default": "below",
          "description": "Above or below the target; below when omitted.",
          "oneOf": [
            {
              "const": "above",
              "description": "Above it.",
              "type": "string"
            },
            {
              "const": "below",
              "description": "Below it (the default).",
              "type": "string"
            }
          ]
        },
        "separator": {
          "default": "hyphen",
          "description": "The separator after the chapter number; a hyphen when omitted.",
          "oneOf": [
            {
              "const": "hyphen",
              "description": "`1-1` (the default, as Word's).",
              "type": "string"
            },
            {
              "const": "period",
              "description": "`1.1`.",
              "type": "string"
            },
            {
              "const": "colon",
              "description": "`1:1`.",
              "type": "string"
            },
            {
              "const": "em_dash",
              "description": "`1—1`.",
              "type": "string"
            },
            {
              "const": "en_dash",
              "description": "`1–1`.",
              "type": "string"
            }
          ]
        },
        "target": {
          "description": "The id of the table, picture or paragraph the caption is for.",
          "type": "string"
        },
        "text": {
          "description": "The caption's own text after the number.",
          "type": "string"
        }
      },
      "required": [
        "op",
        "target",
        "label"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Renumber every caption whose number is stale (Word's update fields\nover the captions).",
      "properties": {
        "op": {
          "const": "update_caption_numbers",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Insert a cross-reference at an anchor: a field showing a heading's,\ncaption's or bookmarked paragraph's text, number or page.",
      "properties": {
        "at": {
          "additionalProperties": false,
          "description": "Where the reference goes.",
          "properties": {
            "exact": {
              "description": "The quoted text, matched inside `node` only.",
              "type": [
                "string",
                "null"
              ]
            },
            "node": {
              "description": "A paragraph id returned by `get_outline`, `read_blocks` or `search`.",
              "type": "string"
            },
            "occurrence": {
              "description": "1-based occurrence of `exact` among the matches that remain.",
              "format": "uint32",
              "minimum": 1,
              "type": [
                "integer",
                "null"
              ]
            },
            "pos": {
              "additionalProperties": false,
              "description": "Offsets for programs only; never computed by a model.",
              "properties": {
                "end": {
                  "description": "End, exclusive.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "start": {
                  "description": "Start, UTF-8 bytes into the node's text.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "start",
                "end"
              ],
              "type": [
                "object",
                "null"
              ]
            },
            "prefix": {
              "description": "Text immediately before `exact`, to disambiguate.",
              "type": [
                "string",
                "null"
              ]
            },
            "side": {
              "anyOf": [
                {
                  "description": "Which side of the target an insertion goes.",
                  "oneOf": [
                    {
                      "const": "before",
                      "description": "Before the quote (or at the paragraph's start).",
                      "type": "string"
                    },
                    {
                      "const": "after",
                      "description": "After the quote (or at the paragraph's end). The default.",
                      "type": "string"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "For an insertion point: before or after the target."
            },
            "suffix": {
              "description": "Text immediately after `exact`, to disambiguate.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "node"
          ],
          "type": "object"
        },
        "hyperlink": {
          "default": false,
          "description": "Make the reference a link to its target.",
          "type": "boolean"
        },
        "include_above_below": {
          "default": false,
          "description": "Follow it with `above` or `below`, as Word's checkbox does.",
          "type": "boolean"
        },
        "op": {
          "const": "insert_cross_reference",
          "type": "string"
        },
        "show": {
          "description": "What the reference shows.",
          "oneOf": [
            {
              "const": "entire_caption",
              "description": "A caption's label, number and text.",
              "type": "string"
            },
            {
              "const": "label_and_number",
              "description": "A caption's label and number only (`Figure 2`).",
              "type": "string"
            },
            {
              "const": "caption_text",
              "description": "A caption's text after its number.",
              "type": "string"
            },
            {
              "const": "page_number",
              "description": "The page label of the page the target is on.",
              "type": "string"
            },
            {
              "const": "above_below",
              "description": "The word `above` or `below`, from where the reference sits.",
              "type": "string"
            },
            {
              "const": "paragraph_text",
              "description": "The target paragraph's text (a heading's, a bookmarked paragraph's).",
              "type": "string"
            }
          ]
        },
        "target": {
          "description": "The paragraph referred to: a heading, a caption, a bookmarked\nparagraph or a note's first paragraph.",
          "type": "string"
        }
      },
      "required": [
        "op",
        "at",
        "target",
        "show"
      ],
      "type": "object"
    }
  ]
}

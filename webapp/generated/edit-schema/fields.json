{
  "description": "One edit of the `fields` family of the OpenDoc edit vocabulary 1.6.",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "Insert a field at an anchor.",
      "properties": {
        "at": {
          "additionalProperties": false,
          "description": "Where.",
          "properties": {
            "exact": {
              "description": "The quoted text, matched inside `node` only.",
              "type": [
                "string",
                "null"
              ]
            },
            "node": {
              "description": "A paragraph id returned by `get_outline`, `read_blocks` or `search`.",
              "type": "string"
            },
            "occurrence": {
              "description": "1-based occurrence of `exact` among the matches that remain.",
              "format": "uint32",
              "minimum": 1,
              "type": [
                "integer",
                "null"
              ]
            },
            "pos": {
              "additionalProperties": false,
              "description": "Offsets for programs only; never computed by a model.",
              "properties": {
                "end": {
                  "description": "End, exclusive.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "start": {
                  "description": "Start, UTF-8 bytes into the node's text.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "start",
                "end"
              ],
              "type": [
                "object",
                "null"
              ]
            },
            "prefix": {
              "description": "Text immediately before `exact`, to disambiguate.",
              "type": [
                "string",
                "null"
              ]
            },
            "side": {
              "anyOf": [
                {
                  "description": "Which side of the target an insertion goes.",
                  "oneOf": [
                    {
                      "const": "before",
                      "description": "Before the quote (or at the paragraph's start).",
                      "type": "string"
                    },
                    {
                      "const": "after",
                      "description": "After the quote (or at the paragraph's end). The default.",
                      "type": "string"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "For an insertion point: before or after the target."
            },
            "suffix": {
              "description": "Text immediately after `exact`, to disambiguate.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "node"
          ],
          "type": "object"
        },
        "kind": {
          "description": "Which field.",
          "oneOf": [
            {
              "const": "page",
              "description": "The current page number (`PAGE`), recomputed at pagination.",
              "type": "string"
            },
            {
              "const": "numpages",
              "description": "The page count (`NUMPAGES`), recomputed at pagination.",
              "type": "string"
            },
            {
              "const": "date",
              "description": "The date (`DATE`); `result` is the date as it should read.",
              "type": "string"
            },
            {
              "const": "time",
              "description": "The time (`TIME`); `result` is the time as it should read.",
              "type": "string"
            },
            {
              "const": "filename",
              "description": "The file name (`FILENAME`); `result` is the name as it should read.",
              "type": "string"
            },
            {
              "const": "author",
              "description": "The author (`AUTHOR`); `result` is the name as it should read.",
              "type": "string"
            }
          ]
        },
        "op": {
          "const": "insert_field",
          "type": "string"
        },
        "result": {
          "description": "The displayed value of a date, time, file-name or author field\n(the engine reads no clock or file system); ignored for page\nnumbers, which are computed.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "op",
        "at",
        "kind"
      ],
      "type": "object"
    }
  ]
}

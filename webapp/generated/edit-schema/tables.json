        "rows": {
          "description": "Rows, 1 to 50.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "op",
        "after",
        "rows",
        "columns"
      ],
      "type": "object"
    },

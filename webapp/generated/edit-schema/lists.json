{
  "description": "One edit of the `lists` family of the OpenDoc edit vocabulary 1.2.",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "Put a paragraph in a bulleted or numbered list, or take it out.",
      "properties": {
        "kind": {
          "description": "Which list.",
          "oneOf": [
            {
              "const": "bullet",
              "description": "A bulleted list.",
              "type": "string"
            },
            {
              "const": "numbered",
              "description": "A decimal numbered list.",
              "type": "string"
            },
            {
              "const": "none",
              "description": "No list: the paragraph leaves its list.",
              "type": "string"
            }
          ]
        },
        "op": {
          "const": "set_list",
          "type": "string"
        },
        "target": {
          "additionalProperties": false,
          "description": "The paragraph.",
          "properties": {
            "exact": {
              "description": "The quoted text, matched inside `node` only.",
              "type": [
                "string",
                "null"
              ]
            },
            "node": {
              "description": "A paragraph id returned by `get_outline`, `read_blocks` or `search`.",
              "type": "string"
            },
            "occurrence": {
              "description": "1-based occurrence of `exact` among the matches that remain.",
              "format": "uint32",
              "minimum": 1,
              "type": [
                "integer",
                "null"
              ]
            },
            "pos": {
              "additionalProperties": false,
              "description": "Offsets for programs only; never computed by a model.",
              "properties": {
                "end": {
                  "description": "End, exclusive.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "start": {
                  "description": "Start, UTF-8 bytes into the node's text.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "start",
                "end"
              ],
              "type": [
                "object",
                "null"
              ]
            },
            "prefix": {
              "description": "Text immediately before `exact`, to disambiguate.",
              "type": [
                "string",
                "null"
              ]
            },
            "side": {
              "anyOf": [
                {
                  "description": "Which side of the target an insertion goes.",
                  "oneOf": [
                    {
                      "const": "before",
                      "description": "Before the quote (or at the paragraph's start).",
                      "type": "string"
                    },
                    {
                      "const": "after",
                      "description": "After the quote (or at the paragraph's end). The default.",
                      "type": "string"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "For an insertion point: before or after the target."
            },
            "suffix": {
              "description": "Text immediately after `exact`, to disambiguate.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "node"
          ],
          "type": "object"
        }
      },
      "required": [
        "op",
        "target",
        "kind"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Move a list item down (`delta` > 0) or up a level.",

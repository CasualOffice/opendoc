.DS_Store
target/
fuzz/artifacts/
fuzz/corpus/
fuzz/coverage/
fuzz/target/
dist/
# Both spellings on purpose. `node_modules/` matches only a DIRECTORY, so a
# SYMLINK named node_modules slipped past it and was committed as a 120000 blob
# pointing at one machine's absolute path. On CI that link dangles and the Pages
# job dies in `tar: ./node_modules: File removed before we read it`.
node_modules/
node_modules
.idea/
.vscode/
*.log

# Claude Code local worktrees and session data
# Agent-local state is ignored, but the checked-in repo SKILL (the working
# contract every agent must load) is not — it is shared with the team.
.claude/*
!.claude/skills/
.claude/worktrees/

